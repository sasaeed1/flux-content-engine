{
  "name": "content-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous AI Instagram content engine — carousels, posts, captions, hashtags. Multi-tenant SaaS module of WappFlow.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed:themes": "tsx scripts/seed-themes.ts",
    "test:pipeline": "tsx scripts/test-pipeline.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "handlebars": "^4.7.8",
    "node-cron": "^3.0.3",
    "openai": "^4.71.1",
    "pdf-parse": "^1.1.4",
    "pino": "^9.5.0",
    "puppeteer-core": "^23.6.0",
    "sharp": "^0.33.5",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
