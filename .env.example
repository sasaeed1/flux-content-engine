# ============================================================
#  CONTENT ENGINE — Environment Configuration
#  Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# ---------- Server ----------
NODE_ENV=production
PORT=8090
LOG_LEVEL=info
TZ=UTC
# Shared secret for ops endpoints (n8n / WappFlow). Tenant endpoints use org API keys.
INTERNAL_API_KEY=change-me-to-a-long-random-string

# ---------- Supabase (multi-tenant database + storage) ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_IMAGE_BUCKET=content-images
SUPABASE_RENDER_BUCKET=content-renders
SUPABASE_LOGO_BUCKET=brand-logos

# ---------- AI provider (LLM) ----------
# AI_PROVIDER: groq | openai | ollama
# Groq has a free tier and is OpenAI-API-compatible (recommended for dev).
# Per-tenant overrides can be stored on the organization row.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------- Image generation (optional) ----------
# IMAGE_PROVIDER: none | openai | comfyui | fal
# Default "none" composes slides from template backgrounds only (free).
IMAGE_PROVIDER=none
OPENAI_IMAGE_MODEL=gpt-image-1
COMFYUI_BASE_URL=http://localhost:8188
FAL_API_KEY=

# ---------- Renderer ----------
# puppeteer-core needs a Chrome/Chromium binary. Leave blank to auto-detect.
# Docker: /usr/bin/chromium (set by the Dockerfile).
CHROME_EXECUTABLE_PATH=

# ---------- Motion / Reels (zero-cost ffmpeg reel engine) ----------
# Carousels can be turned into cinematic MP4 reels. Rendering uses the bundled
# ffmpeg-static binary (no system ffmpeg needed) — set FFMPEG_PATH only to
# override with a system ffmpeg. Reels upload to SUPABASE_REEL_BUCKET (auto-
# created on boot). REEL_DEFAULT_ASPECT: reel (9:16) | square (1:1) | portrait (4:5).
ENABLE_MOTION=true
FFMPEG_PATH=
SUPABASE_REEL_BUCKET=content-reels
REEL_DEFAULT_ASPECT=reel
MOTION_RENDER_TIMEOUT_SEC=300

# ---------- Scheduler ----------
ENABLE_INTERNAL_SCHEDULER=true
PUBLISH_QUEUE_CRON=*/10 * * * *
RETRY_CRON=*/15 * * * *
ANALYTICS_CRON=0 */6 * * *
# n8n owns the daily creative trigger by default; flip to true to run it here.
ENABLE_DAILY_PIPELINE_CRON=false
DAILY_PIPELINE_CRON=0 9 * * *

# ---------- Pipeline tuning ----------
DEFAULT_CAROUSEL_SLIDES=7
MAX_CAROUSEL_SLIDES=10
PUBLISH_POLL_TIMEOUT_SEC=300
IMAGE_GEN_TIMEOUT_SEC=120

# ---------- Instagram Graph API ----------
# Default API version (per-org tokens are stored on instagram_accounts rows).
IG_GRAPH_API_VERSION=v21.0

# ---------- WappFlow integration ----------
# Outbound webhook URL inside WappFlow for events (post published, lead captured).
WAPPFLOW_WEBHOOK_URL=
WAPPFLOW_WEBHOOK_SECRET=

# ---------- n8n (used by docker-compose only) ----------
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
